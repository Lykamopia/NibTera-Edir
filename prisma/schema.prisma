// Edir Management Platform — multi-tenant schema
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenancy & Identity ──────────────────────────────────────────────────────

model Edir {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  roles         Role[]
  members       Member[]
  settings      EdirSettings?
  paymentLogs   PaymentLog[]
  approvals     ApprovalRequest[]
  notifications Notification[]
  auditLogs     AuditLog[]
  emergencyTypes EmergencyType[]
  emergencyClaims EmergencyClaim[]
  events        Event[]
  assetCategories AssetCategory[]
  assets        Asset[]
  ruleChangeLogs RuleChangeLog[]
  bylaws        Bylaw[]
  rulesVersions RulesVersion[]
  memberRequests MemberRequest[]
}

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  phone               String?   @unique // 251-normalized Ethiopian phone
  title               String?
  emailVerified       DateTime?
  avatar              String?
  hashedPassword      String?
  status              String    @default("INVITED") // INVITED, ACTIVE, INACTIVE, SUSPENDED
  mustChangePassword  Boolean   @default(false)
  onboardingCompleted Boolean   @default(false)
  tokenVersion        Int       @default(0)
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  passwordResetCount  Int       @default(0)
  lastPasswordResetAt DateTime?
  lastIp              String?
  lastUserAgent       String?
  twoFactorEnabled    Boolean   @default(false)
  twoFactorSecret     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id])
  edirId String?
  edir   Edir?   @relation(fields: [edirId], references: [id])

  member               Member?               @relation("MemberLogin")
  securityLogs         SecurityLog[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  approvalsMade        ApprovalRequest[]     @relation("ApprovalMaker")
  approvalsChecked     ApprovalRequest[]     @relation("ApprovalChecker")
  approvalEvents       ApprovalEvent[]
  rulesAuthored        RulesVersion[]        @relation("RulesAuthor")
  rulesApproved        RulesVersion[]        @relation("RulesApprover")
  memberRequestsReviewed MemberRequest[]     @relation("MemberRequestReviewer")

  @@index([roleId])
  @@index([edirId])
  @@index([phone])
}

// Organizational scope of a role (system roles span all tenants).
enum RoleScope {
  SUPER_ADMIN
  EDIR
}

model Role {
  id          String    @id @default(cuid())
  name        String
  permissions String    @default("") // CSV of permission ids
  scope       RoleScope @default(EDIR)
  edirId      String? // null = global/system role
  edir        Edir?     @relation(fields: [edirId], references: [id])
  users       User[]

  @@unique([edirId, name])
  @@index([edirId])
}

// ─── Members ─────────────────────────────────────────────────────────────────

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
}

model Member {
  id                    String       @id @default(cuid())
  edirId                String
  edir                  Edir         @relation(fields: [edirId], references: [id])
  memberId              String // EDR-YYYY-NNNN, unique within an edir
  userId                String?      @unique
  user                  User?        @relation("MemberLogin", fields: [userId], references: [id], onDelete: SetNull)

  // Personal
  name                  String
  occupation            String?
  photoUrl              String?
  dateOfBirth           DateTime?
  gender                String?
  nationalId            String?
  // Contact
  phone                 String?
  email                 String?
  address               String?
  city                  String?
  subcity               String?
  woreda                String?
  // Emergency contact
  emergencyContactName  String?
  emergencyContactPhone String?
  // Membership
  role                  String       @default("Member")
  status                MemberStatus @default(ACTIVE)
  joinDate              DateTime     @default(now())
  registrationInstallmentCount Int   @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentStatus   PaymentStatus?
  relatives       Relative[]
  documents       MemberDocument[]
  installmentPlans InstallmentPlan[]
  paymentLogs     PaymentLog[]
  emergencyClaims EmergencyClaim[]
  eventParticipations EventParticipant[]
  assetIssuances  AssetIssuance[]
  requests        MemberRequest[]

  @@unique([edirId, memberId])
  @@index([edirId])
  @@index([status])
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model Relative {
  id            String     @id @default(cuid())
  memberId      String
  member        Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name          String
  relationship  String     // SPOUSE | CHILD | PARENT | SIBLING | BENEFICIARY | OTHER (or free text)
  phone         String?
  dateOfBirth   DateTime?
  isBeneficiary Boolean    @default(false)
  benefitShare  Int?       // optional percentage share for beneficiaries
  isDependent   Boolean    @default(false)
  notes         String?
  createdAt     DateTime   @default(now())
  documents     RelativeDocument[]

  @@index([memberId])
}

model RelativeDocument {
  id         String         @id @default(cuid())
  relativeId String
  relative   Relative       @relation(fields: [relativeId], references: [id], onDelete: Cascade)
  fileUrl    String
  fileName   String?
  status     DocumentStatus @default(PENDING)
  notes      String?
  createdAt  DateTime       @default(now())

  @@index([relativeId])
}

model MemberDocument {
  id         String         @id @default(cuid())
  memberId   String
  member     Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  category   String         // ID | CERTIFICATE | MEDICAL | PROOF_OF_RELATIONSHIP | PHOTO | OTHER
  fileUrl    String
  fileName   String?
  status     DocumentStatus @default(PENDING)
  notes      String?
  createdAt  DateTime       @default(now())

  @@index([memberId])
}

// ─── Payments & Contributions ────────────────────────────────────────────────

enum PaymentStatusValue {
  PAID
  PENDING
}

model PaymentStatus {
  id          String             @id @default(cuid())
  memberId    String             @unique
  member      Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  balance     Decimal            @default(0) @db.Decimal(15, 2)
  monthsPaid  Int                @default(0)
  totalPaid   Decimal            @default(0) @db.Decimal(15, 2)
  lastPayment DateTime?
  status      PaymentStatusValue @default(PENDING)
  updatedAt   DateTime           @updatedAt
}

enum InstallmentPlanType {
  REGISTRATION
  CONTRIBUTION
}

model InstallmentPlan {
  id          String              @id @default(cuid())
  memberId    String
  member      Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type        InstallmentPlanType
  totalAmount Decimal             @db.Decimal(15, 2)
  createdAt   DateTime            @default(now())
  installments Installment[]

  @@index([memberId])
}

enum InstallmentStatus {
  PENDING
  PAID
}

model Installment {
  id        String            @id @default(cuid())
  planId    String
  plan      InstallmentPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  sequence  Int
  amount    Decimal           @db.Decimal(15, 2)
  dueDate   DateTime
  status    InstallmentStatus @default(PENDING)
  paidAt    DateTime?

  @@unique([planId, sequence])
  @@index([planId])
  @@index([status])
}

enum PaymentLogStatus {
  PENDING
  SUCCESS
  PARTIAL
  FAILED
  VOID
}

model PaymentLog {
  id               String           @id @default(cuid())
  edirId           String
  edir             Edir             @relation(fields: [edirId], references: [id])
  memberId         String?
  member           Member?          @relation(fields: [memberId], references: [id], onDelete: SetNull)
  amount           Decimal          @db.Decimal(15, 2)
  method           String // NIBTERA_MINI_APP, MANUAL, CASH, BANK ...
  status           PaymentLogStatus @default(PENDING)
  description      String? // JSON breakdown
  transactionId    String           @unique
  receiptUrl       String?
  signature        String?
  verificationType String? // AUTOMATIC | MANUAL
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([edirId])
  @@index([memberId])
  @@index([status])
}

// ─── Maker–Checker Engine ────────────────────────────────────────────────────

enum ApprovalModule {
  MANUAL_PAYMENT
  EMERGENCY_CLAIM
  EMERGENCY_DISBURSEMENT
  ASSET_ISSUANCE
  MEMBER_REMOVAL
  RULE_CHANGE
  PENALTY_WAIVER
}

enum ApprovalStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  RETURNED
  CLOSED
}

enum ApprovalEventType {
  SUBMITTED
  COMMENTED
  APPROVED
  EXECUTED
  REJECTED
  RETURNED
  RESUBMITTED
}

model ApprovalRequest {
  id         String         @id @default(cuid())
  edirId     String
  edir       Edir           @relation(fields: [edirId], references: [id])
  module     ApprovalModule
  title      String
  summary    String?
  payload    Json
  status     ApprovalStatus @default(PENDING)
  makerId    String
  maker      User           @relation("ApprovalMaker", fields: [makerId], references: [id])
  checkerId  String?
  checker    User?          @relation("ApprovalChecker", fields: [checkerId], references: [id])
  targetType String?
  targetId   String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  events     ApprovalEvent[]

  @@index([edirId])
  @@index([module])
  @@index([status])
  @@index([makerId])
}

model ApprovalEvent {
  id        String            @id @default(cuid())
  requestId String
  request   ApprovalRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  type      ApprovalEventType
  actorId   String
  actor     User              @relation(fields: [actorId], references: [id])
  comment   String?
  createdAt DateTime          @default(now())

  @@index([requestId])
}

// ─── Per-Edir Settings & Rules ───────────────────────────────────────────────

model EdirSettings {
  id                String  @id @default(cuid())
  edirId            String  @unique
  edir              Edir    @relation(fields: [edirId], references: [id], onDelete: Cascade)
  monthlyFee        Decimal @default(0) @db.Decimal(15, 2)
  registrationFee   Decimal @default(0) @db.Decimal(15, 2)
  currency          String  @default("ETB")
  dueDay            Int     @default(1) // day of month payments are due
  gracePeriodDays   Int     @default(5)
  penaltyTiers      Json? // [{ id, label, fromDays, toDays|null, type: 'FIXED'|'PERCENT', value }]
  autoSuspendMonths Int     @default(3)
  autoTerminateMonths Int   @default(6)
  // Membership rules
  minMembershipMonths Int   @default(0) // minimum tenure for benefit eligibility
  reinstatementFee  Decimal @default(0) @db.Decimal(15, 2)
  autoSuspendEnabled  Boolean @default(true)
  autoReminderEnabled Boolean @default(true)
  memberRoles       Json? // configurable member role names, e.g. ["Member","Chairperson","Treasurer"]
  emergencyReserve  Decimal @default(0) @db.Decimal(15, 2)
  operatingFund     Decimal @default(0) @db.Decimal(15, 2)
  updatedAt         DateTime @updatedAt
}

model RuleChangeLog {
  id           String   @id @default(cuid())
  edirId       String
  edir         Edir     @relation(fields: [edirId], references: [id])
  field        String
  previousValue String?
  newValue     String?
  changedById  String?
  comment      String?
  createdAt    DateTime @default(now())

  @@index([edirId])
}

model Bylaw {
  id        String   @id @default(cuid())
  edirId    String
  edir      Edir     @relation(fields: [edirId], references: [id], onDelete: Cascade)
  section   String?
  title     String
  content   String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([edirId])
}

// ─── Rules & Bylaws (versioned official document) ────────────────────────────

enum RulesVersionStatus {
  DRAFT     // editable; pending approval is represented by an open ApprovalRequest
  APPROVED  // the live, member-visible version (at most one per Edir)
  ARCHIVED  // a previously approved version, kept for history
}

model RulesVersion {
  id            String             @id @default(cuid())
  edirId        String
  edir          Edir               @relation(fields: [edirId], references: [id], onDelete: Cascade)
  versionNumber Int
  title         String
  content       String             @db.Text // sanitized rich-text HTML
  changeSummary String?            @db.Text
  effectiveDate DateTime?
  status        RulesVersionStatus @default(DRAFT)
  authorId      String?
  author        User?              @relation("RulesAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  approverId    String?
  approver      User?              @relation("RulesApprover", fields: [approverId], references: [id], onDelete: SetNull)
  approvedAt    DateTime?
  comment       String?
  attachments   RulesAttachment[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([edirId])
  @@index([status])
}

model RulesAttachment {
  id        String       @id @default(cuid())
  versionId String
  version   RulesVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  name      String
  url       String
  createdAt DateTime     @default(now())

  @@index([versionId])
}

// ─── Member self-service requests (relative / emergency / asset / grievance) ──

enum MemberRequestType {
  RELATIVE
  EMERGENCY
  ASSET
  GRIEVANCE
  FEEDBACK
}

enum MemberRequestStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  RESOLVED
}

model MemberRequest {
  id           String              @id @default(cuid())
  edirId       String
  edir         Edir                @relation(fields: [edirId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  type         MemberRequestType
  category     String? // e.g. grievance category, asset name, relationship
  subject      String
  description  String?             @db.Text
  payload      Json? // type-specific structured data
  attachments  Json? // [{ name, url }]
  status       MemberRequestStatus @default(PENDING)
  response     String?             @db.Text
  reviewedById String?
  reviewedBy   User?               @relation("MemberRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([edirId])
  @@index([memberId])
  @@index([status])
}

// ─── Emergencies (later-iteration models, defined now) ───────────────────────

model EmergencyType {
  id            String  @id @default(cuid())
  edirId        String
  edir          Edir    @relation(fields: [edirId], references: [id])
  name          String
  description   String?
  basePayout    Decimal @default(0) @db.Decimal(15, 2)
  relationshipPayouts Json? // { relationship: amount }
  documentationRequired Boolean @default(false)
  requiredDocuments String? // comma-separated list of required document names
  requiresApproval Boolean @default(true)
  waitingPeriodDays Int    @default(0)
  eligibilityMonths Int    @default(0) // minimum membership tenure to claim this type
  isActive      Boolean @default(true)
  claims        EmergencyClaim[]

  @@index([edirId])
}

enum EmergencyStatus {
  REPORTED
  PENDING
  ACTIVE
  RESOLVED
  REJECTED
}

model EmergencyClaim {
  id             String          @id @default(cuid())
  edirId         String
  edir           Edir            @relation(fields: [edirId], references: [id])
  memberId       String
  member         Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  typeId         String?
  type           EmergencyType?  @relation(fields: [typeId], references: [id], onDelete: SetNull)
  affectedPerson String?
  description    String?
  date           DateTime?
  location       String?
  priority       String          @default("normal")
  status         EmergencyStatus @default(REPORTED)
  approvedAmount Decimal?        @db.Decimal(15, 2)
  disbursedAmount Decimal?       @db.Decimal(15, 2)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  notes          EmergencyNote[]

  @@index([edirId])
  @@index([memberId])
  @@index([status])
}

model EmergencyNote {
  id        String         @id @default(cuid())
  claimId   String
  claim     EmergencyClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  note      String?
  fileUrl   String?
  createdAt DateTime       @default(now())

  @@index([claimId])
}

// ─── Events & Attendance (later-iteration models, defined now) ───────────────

enum EventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Event {
  id                 String      @id @default(cuid())
  edirId             String
  edir               Edir        @relation(fields: [edirId], references: [id])
  title              String
  datetime           DateTime
  location           String?
  attendanceRequired Boolean     @default(false)
  absencePenalty     Decimal     @default(0) @db.Decimal(15, 2)
  status             EventStatus @default(SCHEDULED)
  createdAt          DateTime    @default(now())
  participants       EventParticipant[]

  @@index([edirId])
}

enum ParticipantStatus {
  INVITED
  ATTENDING
  DECLINED
  PRESENT
  ABSENT
  EXCUSED
}

model EventParticipant {
  id        String            @id @default(cuid())
  eventId   String
  event     Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId  String
  member    Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status    ParticipantStatus @default(INVITED)
  penalized Boolean           @default(false)

  @@unique([eventId, memberId])
  @@index([eventId])
}

// ─── Assets (later-iteration models, defined now) ────────────────────────────

model AssetCategory {
  id     String  @id @default(cuid())
  edirId String
  edir   Edir    @relation(fields: [edirId], references: [id])
  name   String
  assets Asset[]

  @@index([edirId])
}

model Asset {
  id               String   @id @default(cuid())
  edirId           String
  edir             Edir     @relation(fields: [edirId], references: [id])
  categoryId       String?
  category         AssetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name             String
  purchaseValue    Decimal  @default(0) @db.Decimal(15, 2)
  currentValue     Decimal  @default(0) @db.Decimal(15, 2)
  quantity         Int      @default(1)
  issuedQuantity   Int      @default(0)
  condition        String   @default("good")
  location         String?
  status           String   @default("available")
  compensationCost Decimal  @default(0) @db.Decimal(15, 2)
  createdAt        DateTime @default(now())
  issuances        AssetIssuance[]

  @@index([edirId])
  @@index([categoryId])
}

enum AssetIssuanceStatus {
  REQUESTED
  APPROVED
  ISSUED
  RETURNED
  COMPENSATION_PENDING
  CLOSED
}

model AssetIssuance {
  id            String              @id @default(cuid())
  assetId       String
  asset         Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  memberId      String?
  member        Member?             @relation(fields: [memberId], references: [id], onDelete: SetNull)
  status        AssetIssuanceStatus @default(REQUESTED)
  issuedQty     Int                 @default(0)
  returnedQty   Int                 @default(0)
  condition     String?
  compensation  Decimal?            @db.Decimal(15, 2)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([assetId])
}

// ─── Notifications, Audit, System ────────────────────────────────────────────

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  edirId     String?
  edir       Edir?     @relation(fields: [edirId], references: [id], onDelete: SetNull)
  type       String
  priority   String    @default("normal")
  title      String
  body       String
  linkUrl    String?
  entityId   String?
  entityType String?
  read       Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  edirId     String?
  edir       Edir?    @relation(fields: [edirId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  details    String?  @db.Text
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([edirId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model PasswordResetToken {
  email     String   @id
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model EmailLog {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  from            String
  to              String
  cc              String?
  subject         String
  body            String   @db.Text
  status          String
  triggerEvent    String?
  relatedEntityId String?
  errorMessage    String?
  messageId       String?
}

model SecurityLog {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  actorId    String?
  event      String
  severity   String
  ipAddress  String?
  userAgent  String?
  details    String   @db.Text
  targetId   String?
  targetType String?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([event])
  @@index([timestamp])
}
